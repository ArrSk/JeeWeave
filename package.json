{
  "name": "jeeweave",
  "private": true,
  "version": "0.4.0",
  "main": "desktop/main.cjs",
  "author": "ArrSk",
  "repository": { "type": "git", "url": "https://github.com/ArrSk/JeeWeave.git" },
  "homepage": "https://arrsk.github.io/JeeWeave/",
  "description": "几微 · JeeWeave，本地优先的课程与个人工作台（Web/PWA + Windows Desktop）",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @jeeweave/web dev",
    "build": "pnpm --filter @jeeweave/web build",
    "preview": "pnpm --filter @jeeweave/web preview",
    "desktop:build": "node desktop/package-desktop.cjs",
    "desktop:run": "electron desktop/main.cjs",
    "mobile:prepare": "node mobile/prepare.mjs",
    "mobile:build": "pwsh -NoProfile -File mobile/build.ps1",
    "mobile:test": "node mobile/prepare.mjs && node --test mobile/bridge.test.mjs mobile/assistant.test.mjs",
    "mobile:test:ui": "node mobile/test-ui.mjs",
    "desktop:test": "node --test desktop/*.test.mjs",
    "desktop:test:portal": "electron desktop/tests/portal-flow.cjs",
    "desktop:test:close": "electron desktop/tests/close-app.cjs",
    "desktop:test:capture": "electron desktop/tests/course-capture.cjs",
    "desktop:test:capture-vpn": "electron desktop/tests/course-capture-vpn.cjs",
    "desktop:test:import-ui": "electron desktop/tests/course-import-ui.cjs",
    "desktop:test:workbench-ui": "electron desktop/tests/workbench-ui.cjs",
    "desktop:test:features": "electron desktop/tests/workbench-features.cjs",
    "desktop:test:workspace": "node desktop/tests/workspace-flow.cjs",
    "desktop:test:reset": "node desktop/tests/reset-flow.cjs",
    "web:test:ui": "electron web/tests/ui-smoke.cjs",
    "desktop:package": "node desktop/package-desktop.cjs",
    "test": "pnpm --filter @jeeweave/core test && pnpm --filter @jeeweave/data test && pnpm --filter @jeeweave/web test",
    "typecheck": "tsc -p shared/packages/core --noEmit && tsc -p shared/packages/data --noEmit && tsc -p shared/packages/ui --noEmit && tsc -p shared/packages/platform --noEmit && tsc -p web --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "status": "node scripts/status.mjs",
    "check:repo": "node scripts/audit-repository.mjs",
    "save": "node scripts/save.mjs"
  },
  "build": {
    "appId": "cn.jeeweave.app",
    "productName": "几微",
    "directories": { "output": "desktop/release" },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "package.json",
      "desktop/assets/app-icon.svg",
      "desktop/assets/app-icon.png",
      "desktop/assets/app-icon.ico",
      "desktop/main.cjs",
      "desktop/assistant-platform.cjs",
      "desktop/assistant-core.mjs",
      "desktop/assistant-ui.mjs",
      "desktop/assistant-plugin.mjs",
      "desktop/reminder-plugin.mjs",
      "desktop/reminder-ui.mjs",
      "desktop/reminder-core.mjs",
      "desktop/reminder-platform.cjs",
      "desktop/windows-shell.cjs",
      "desktop/reminder-task.ps1",
      "desktop/storage-paths.cjs",
      "desktop/workspace-file.cjs",
      "desktop/workspace-transfer.cjs",
      "desktop/reset-data.cjs",
      "desktop/workspace-format.mjs",
      "desktop/planning.mjs",
      "desktop/planning-ui.mjs",
      "desktop/item-service.mjs",
      "desktop/course-service.mjs",
      "desktop/calendar.mjs",
      "desktop/calendar-ui.mjs",
      "desktop/appearance.mjs",
      "desktop/appearance-ui.mjs",
      "desktop/schedule.mjs",
      "desktop/schedule-ui.mjs",
      "desktop/modules.mjs",
      "desktop/modules-ui.mjs",
      "desktop/course-overlay.mjs",
      "desktop/course-colors.mjs",
      "desktop/course-layout.mjs",
      "desktop/course-occurrences.mjs",
      "desktop/course-files.mjs",
      "desktop/course-tools-ui.mjs",
      "desktop/reading.mjs",
      "desktop/examples.mjs",
      "desktop/object-view.mjs",
      "desktop/object-view-ui.mjs",
      "desktop/search-ui.mjs",
      "desktop/course-editor.mjs",
      "desktop/course-fields.mjs",
      "desktop/chat-monitor.mjs",
      "desktop/chat-monitor-ui.mjs",
      "desktop/chat-receiver.cjs",
      "desktop/app-lifecycle.cjs",
      "desktop/portal-session.cjs",
      "desktop/preload.cjs",
      "desktop/course-capture.cjs",
      "desktop/course-page.cjs",
      "desktop/course-import.mjs",
      "desktop/timetable-store.mjs",
      "desktop/demo-timetable.mjs",
      "desktop/workbench-data.mjs",
      "desktop/web-collector.cjs",
      "desktop/web-extract.mjs",
      "desktop/web-capture-service.mjs",
      "desktop/page-motion.mjs",
      "desktop/ui-text.mjs",
      "desktop/workspace-transaction.mjs",
      "desktop/workbench-host.mjs",
      "desktop/plugin-runtime.mjs",
      "desktop/plugin-storage.mjs",
      "desktop/platform-permissions.cjs",
      "desktop/workbench-services.mjs",
      "desktop/workspace-service.mjs",
      "desktop/object-service.mjs",
      "desktop/calendar-service.mjs",
      "desktop/workbench-views.mjs",
      "desktop/record-router.mjs",
      "desktop/journal.mjs",
      "desktop/journal-ui.mjs",
      "desktop/journal-feature.mjs",
      "desktop/prototype.html",
      "desktop/prototype-modules.js",
      "desktop/workbench.css",
      "shared/packages/core/src/semester-calendar.mjs"
    ],
    "win": {
      "icon": "desktop/assets/app-icon.ico",
      "target": [{ "target": "dir", "arch": ["x64"] }],
      "signAndEditExecutable": false,
      "signExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3"
  }
}
